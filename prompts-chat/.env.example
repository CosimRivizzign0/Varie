# Copia questo file in ".env" e compila i due segreti (oppure lancia ./avvia.sh che lo fa da solo).
# Il file .env NON va committato: è già escluso da .gitignore.

# --- Obbligatori ---
# Password del database PostgreSQL (usata sia dal container db sia dall'app).
# Genera: openssl rand -hex 24   (solo esadecimale: finisce dentro una URL di connessione)
POSTGRES_PASSWORD=

# Segreto per le sessioni di login. Se cambia, tutti gli utenti vengono scollegati.
# Genera: openssl rand -base64 32
AUTH_SECRET=

# --- Opzionali ---
# Porta sull'host (l'app dentro il container resta sulla 3000)
PORT=4444

# Branding
PCHAT_NAME=La mia libreria di prompt
PCHAT_DESCRIPTION=Prompt raccolti e organizzati
PCHAT_COLOR=#6366f1

# Lingue disponibili (disponibili a monte: ar,az,de,el,en,es,fa,fr,he,it,ja,ko,nl,pt,ru,tr,zh)
PCHAT_LOCALES=it,en
PCHAT_DEFAULT_LOCALE=it

# Accesso: credentials | github | google (anche combinati: "credentials,github")
PCHAT_AUTH_PROVIDERS=credentials
# Metti false dopo aver creato il tuo utente, se l'istanza deve restare privata
PCHAT_ALLOW_REGISTRATION=true

# OAuth GitHub — callback da registrare: http(s)://TUO-DOMINIO/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# OAuth Google — callback: http(s)://TUO-DOMINIO/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Ricerca semantica / generazione con OpenAI (a consumo, a tuo carico)
# PCHAT_FEATURE_AI_SEARCH=true
# PCHAT_FEATURE_AI_GENERATION=true
# OPENAI_API_KEY=
